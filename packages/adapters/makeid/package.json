{
  "name": "@labelmaker/adapter-makeid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./macos": {
      "types": "./dist/macos-transport.d.ts",
      "import": "./dist/macos-transport.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build && node scripts/build-macos-helper.mjs",
    "hardware:power-cycle": "npm run build && node scripts/hardware-smoke.mjs --power-cycle",
    "hardware:probe": "npm run build && node scripts/hardware-smoke.mjs --probe",
    "hardware:print": "npm run build && node scripts/hardware-smoke.mjs --print",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@labelmaker/printing": "0.0.0"
  }
}
