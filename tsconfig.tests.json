{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/*.test.ts",
    "packages/**/*.d.ts",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
