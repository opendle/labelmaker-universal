{
  "name": "labelmaker-universal",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A portable desktop label editor with pluggable printer adapters.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run react:doctor && npm run typecheck && npm run test && npm run build",
    "dev": "npm run dev --workspace @labelmaker/desktop",
    "icons:generate": "node scripts/generate-icon-catalog.mjs",
    "iphone:deploy": "node apps/ipad/scripts/deploy-device.mjs --iphone",
    "iphone:simulator": "node apps/ipad/scripts/launch-simulator.mjs --iphone",
    "ipad:deploy": "node apps/ipad/scripts/deploy-device.mjs",
    "ipad:simulator": "node apps/ipad/scripts/launch-simulator.mjs",
    "mas:development": "npm run mas:development --workspace @labelmaker/desktop",
    "mas:distribution": "npm run mas:distribution --workspace @labelmaker/desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app-store:screenshots": "npm run app-store:screenshots:mobile && npm run app-store:screenshots:macos",
    "app-store:screenshots:macos": "npm run app-store:screenshots --workspace @labelmaker/desktop",
    "app-store:screenshots:mobile": "npm run app-store:screenshots --workspace @labelmaker/ipad",
    "app-store:previews": "npm run app-store:previews:mobile && npm run app-store:previews:macos",
    "app-store:previews:macos": "npm run video --workspace @labelmaker/desktop",
    "app-store:previews:mobile": "npm run app-store:previews --workspace @labelmaker/ipad",
    "react:doctor": "node scripts/react-doctor-gate.mjs",
    "responsive:screenshots": "npm run responsive:screenshots --workspace @labelmaker/ipad",
    "test": "vitest run",
    "typecheck": "tsc --build && tsc --project tsconfig.tests.json && npm run typecheck --workspaces --if-present",
    "ui:screenshot": "npm run screenshot --workspace @labelmaker/desktop",
    "ui:video": "npm run video --workspace @labelmaker/desktop"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "44.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.8.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "electron@44.0.0": true
  }
}
